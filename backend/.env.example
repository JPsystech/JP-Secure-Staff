# JP Secure Staff - Backend env template. Copy to .env and fill values.
# Required
DATABASE_URL=postgresql://user:password@localhost:5432/jp_secure_staff
SECRET_KEY=your-secret-key-min-32-characters-for-production

# Optional (defaults shown)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Storage: USE_MINIO=false uses local filesystem
USE_MINIO=false
STORAGE_PATH=
# If USE_MINIO=true:
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=jp-secure-staff

# Email (Step-12)
EMAIL_DRY_RUN=true
EMAIL_BIRTHDAY_SEND_HOUR=9
AUTO_SEND_ID_CARD=true
APP_BASE_URL=http://localhost:3000
# If EMAIL_DRY_RUN=false set SMTP_*:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=JP Secure Staff
# SMTP_USE_TLS=true

# Scheduler
SCHEDULER_ENABLED=true
