# JP Secure Staff - Frontend (Next.js)
# Copy to .env.local for local development. For production (e.g. Render/Vercel), set in dashboard.

# API base URL (recommended: use NEXT_PUBLIC_API_BASE_URL)
# - Next.js: NEXT_PUBLIC_API_BASE_URL or NEXT_PUBLIC_API_URL
# - No trailing slash. If omitted, /api/v1 is appended automatically.
# Production (Render backend):
NEXT_PUBLIC_API_BASE_URL=https://jp-secure-staff.onrender.com
# Or full path (also supported):
# NEXT_PUBLIC_API_URL=https://jp-secure-staff.onrender.com/api/v1

# Local development (default if unset):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
